    else if (activeTab == "units")
    {
        <div class="form-inline mb-3">
            <input type="text" @bind="newUnitName" placeholder="Nama Unit Baru" class="form-control" />
            <button class="btn btn-primary" @onclick="AddUnit">Tambah</button>
        </div>
        <table class="user-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama Unit</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (units != null)
                {
                    @foreach (var item in units)
                    {
                        <tr>
                            <td>@item.UnitID</td>
                            <td>
                                @if (editingUnitId == item.UnitID)
                                {
                                    <input type="text" @bind="editUnitName" class="form-control" />
                                }
                                else
                                {
