@page "/admin/master-data"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ActivityTracking.Data

@attribute [Authorize]
@rendermode InteractiveServer

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Master Data Management</PageTitle>

<div class="page-header">
    <h1>Master Data Management</h1>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">
        @message
    </div>
}

<div class="tabs">
    <button class="tab-btn @(activeTab == "activities" ? "active" : "")" @onclick="@(() => SetTab("activities"))">Aktivitas</button>
    <button class="tab-btn @(activeTab == "frequencies" ? "active" : "")" @onclick="@(() => SetTab("frequencies"))">Frekuensi</button>
    <button class="tab-btn @(activeTab == "methods" ? "active" : "")" @onclick="@(() => SetTab("methods"))">Metode Kerja</button>
    <button class="tab-btn @(activeTab == "applications" ? "active" : "")" @onclick="@(() => SetTab("applications"))">Aplikasi</button>
    <button class="tab-btn @(activeTab == "jabatans" ? "active" : "")" @onclick="@(() => SetTab("jabatans"))">Jabatan</button>
    <button class="tab-btn @(activeTab == "bagians" ? "active" : "")" @onclick="@(() => SetTab("bagians"))">Bagian</button>
    <button class="tab-btn @(activeTab == "units" ? "active" : "")" @onclick="@(() => SetTab("units"))">Unit</button>
    <button class="tab-btn @(activeTab == "computers" ? "active" : "")" @onclick="@(() => SetTab("computers"))">Komputer</button>
    <button class="tab-btn @(activeTab == "penggunas" ? "active" : "")" @onclick="@(() => SetTab("penggunas"))">Digunakan Oleh</button>
    <button class="tab-btn @(activeTab == "jenisdoks" ? "active" : "")" @onclick="@(() => SetTab("jenisdoks"))">Jenis Dokumen</button>
    <button class="tab-btn @(activeTab == "asaldoks" ? "active" : "")" @onclick="@(() => SetTab("asaldoks"))">Asal Dokumen</button>
</div>

<div class="card">
    @if (activeTab == "activities")
    {
        <div class="form-inline mb-3">
            <input type="text" @bind="newActivityName" placeholder="Nama Aktivitas Baru" class="form-control" />
            <button class="btn btn-primary" @onclick="AddActivity">Tambah</button>
        </div>
        <table class="user-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama Aktivitas</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (activities != null)
                {
                    @foreach (var item in activities)
                    {
                        <tr>
                            <td>@item.AktivitasID</td>
                            <td>
                                @if (editingActivityId == item.AktivitasID)
                                {
                                    <input type="text" @bind="editActivityName" class="form-control" />
                                }
                                else
                                {
                                    @item.NamaAktivitas
                                }
                            </td>
                            <td>@(item.IsActive ? "Aktif" : "Nonaktif")</td>
                            <td>
                                @if (editingActivityId == item.AktivitasID)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveActivity(item)">Simpan</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Batal</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="() => EditActivity(item)">Edit</button>
                                    <button class="btn btn-warning btn-sm" @onclick="() => ToggleActivityStatus(item)">@(item.IsActive ? "Nonaktifkan" : "Aktifkan")</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
