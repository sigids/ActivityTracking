</div>

@code {
    private string activeTab = "activities";
    private string? message;
    private bool isError;

    private List<MasterActivity>? activities;
    private List<MasterFrequency>? frequencies;
    private List<MasterWorkMethod>? methods;
    private List<MasterApplication>? applications;
    private List<MasterJabatan>? jabatans;
    private List<MasterBagian>? bagians;
    private List<MasterUnit>? units;

    private string newActivityName = "";
    private string newFrequencyName = "";
    private string newMethodName = "";
    private string newAppName = "";
    private string newJabatanName = "";
    private string newBagianName = "";
    private string newUnitName = "";

    private int? editingActivityId;
    private int? editingFrequencyId;
    private int? editingMethodId;
    private int? editingAppId;
    private int? editingJabatanId;
    private int? editingBagianId;
    private int? editingUnitId;

    private string editActivityName = "";
    private string editFrequencyName = "";
    private string editMethodName = "";
    private string editAppName = "";
    private string editJabatanName = "";
    private string editBagianName = "";
    private string editUnitName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        activities = await DbContext.MasterActivities.OrderBy(x => x.AktivitasID).ToListAsync();
        frequencies = await DbContext.MasterFrequencies.OrderBy(x => x.FrequencyID).ToListAsync();
        methods = await DbContext.MasterWorkMethods.OrderBy(x => x.MethodID).ToListAsync();
        applications = await DbContext.MasterApplications.OrderBy(x => x.ApplicationID).ToListAsync();
        jabatans = await DbContext.MasterJabatans.OrderBy(x => x.JabatanID).ToListAsync();
        bagians = await DbContext.MasterBagians.OrderBy(x => x.BagianID).ToListAsync();
        units = await DbContext.MasterUnits.OrderBy(x => x.UnitID).ToListAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        CancelEdit();
    }

    private void CancelEdit()
    {
        editingActivityId = null;
        editingFrequencyId = null;
        editingMethodId = null;
        editingAppId = null;
        editingJabatanId = null;
        editingBagianId = null;
        editingUnitId = null;
    }

    // Activities
    private async Task AddActivity()
    {
        if (string.IsNullOrWhiteSpace(newActivityName)) return;
        DbContext.MasterActivities.Add(new MasterActivity { NamaAktivitas = newActivityName });
        await DbContext.SaveChangesAsync();
        newActivityName = "";
        message = "Aktivitas berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditActivity(MasterActivity item)
    {
        editingActivityId = item.AktivitasID;
        editActivityName = item.NamaAktivitas;
    }

    private async Task SaveActivity(MasterActivity item)
    {
        item.NamaAktivitas = editActivityName;
        await DbContext.SaveChangesAsync();
        editingActivityId = null;
        message = "Aktivitas berhasil diupdate";
        isError = false;
    }

    private async Task ToggleActivityStatus(MasterActivity item)
    {
        item.IsActive = !item.IsActive;
        await DbContext.SaveChangesAsync();
        message = $"Status aktivitas berhasil diubah";
        isError = false;
    }

    // Frequencies
    private async Task AddFrequency()
    {
        if (string.IsNullOrWhiteSpace(newFrequencyName)) return;
        DbContext.MasterFrequencies.Add(new MasterFrequency { NamaFrekuensi = newFrequencyName });
        await DbContext.SaveChangesAsync();
        newFrequencyName = "";
        message = "Frekuensi berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditFrequency(MasterFrequency item)
    {
        editingFrequencyId = item.FrequencyID;
        editFrequencyName = item.NamaFrekuensi;
    }

    private async Task SaveFrequency(MasterFrequency item)
    {
        item.NamaFrekuensi = editFrequencyName;
        await DbContext.SaveChangesAsync();
        editingFrequencyId = null;
        message = "Frekuensi berhasil diupdate";
        isError = false;
    }

    private async Task ToggleFrequencyStatus(MasterFrequency item)
    {
        item.IsActive = !item.IsActive;
        await DbContext.SaveChangesAsync();
        message = $"Status frekuensi berhasil diubah";
        isError = false;
    }

    // Methods
    private async Task AddMethod()
    {
        if (string.IsNullOrWhiteSpace(newMethodName)) return;
        DbContext.MasterWorkMethods.Add(new MasterWorkMethod { NamaMetode = newMethodName });
        await DbContext.SaveChangesAsync();
        newMethodName = "";
        message = "Metode kerja berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditMethod(MasterWorkMethod item)
    {
        editingMethodId = item.MethodID;
        editMethodName = item.NamaMetode;
    }

    private async Task SaveMethod(MasterWorkMethod item)
    {
        item.NamaMetode = editMethodName;
        await DbContext.SaveChangesAsync();
        editingMethodId = null;
        message = "Metode kerja berhasil diupdate";
        isError = false;
    }

    private async Task ToggleMethodStatus(MasterWorkMethod item)
    {
        item.IsActive = !item.IsActive;
        await DbContext.SaveChangesAsync();
        message = $"Status metode kerja berhasil diubah";
        isError = false;
    }

    // Applications
    private async Task AddApplication()
    {
        if (string.IsNullOrWhiteSpace(newAppName)) return;
        DbContext.MasterApplications.Add(new MasterApplication { NamaAplikasi = newAppName });
        await DbContext.SaveChangesAsync();
        newAppName = "";
        message = "Aplikasi berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditApplication(MasterApplication item)
    {
        editingAppId = item.ApplicationID;
        editAppName = item.NamaAplikasi;
    }

    private async Task SaveApplication(MasterApplication item)
    {
        item.NamaAplikasi = editAppName;
        await DbContext.SaveChangesAsync();
        editingAppId = null;
        message = "Aplikasi berhasil diupdate";
        isError = false;
    }

    private async Task ToggleAppStatus(MasterApplication item)
    {
        item.IsActive = !item.IsActive;
        await DbContext.SaveChangesAsync();
        message = $"Status aplikasi berhasil diubah";
        isError = false;
    }

    // Jabatans
    private async Task AddJabatan()
    {
        if (string.IsNullOrWhiteSpace(newJabatanName)) return;
        DbContext.MasterJabatans.Add(new MasterJabatan { NamaJabatan = newJabatanName });
        await DbContext.SaveChangesAsync();
        newJabatanName = "";
        message = "Jabatan berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditJabatan(MasterJabatan item)
    {
        editingJabatanId = item.JabatanID;
        editJabatanName = item.NamaJabatan;
    }

    private async Task SaveJabatan(MasterJabatan item)
    {
        item.NamaJabatan = editJabatanName;
        await DbContext.SaveChangesAsync();
        editingJabatanId = null;
        message = "Jabatan berhasil diupdate";
        isError = false;
    }

    private async Task ToggleJabatanStatus(MasterJabatan item)
    {
        item.IsActive = !item.IsActive;
        await DbContext.SaveChangesAsync();
        message = $"Status jabatan berhasil diubah";
        isError = false;
    }

    // Bagians
    private async Task AddBagian()
    {
        if (string.IsNullOrWhiteSpace(newBagianName)) return;
        DbContext.MasterBagians.Add(new MasterBagian { NamaBagian = newBagianName });
        await DbContext.SaveChangesAsync();
        newBagianName = "";
        message = "Bagian berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditBagian(MasterBagian item)
    {
        editingBagianId = item.BagianID;
        editBagianName = item.NamaBagian;
    }

    private async Task SaveBagian(MasterBagian item)
    {
        item.NamaBagian = editBagianName;
        await DbContext.SaveChangesAsync();
        editingBagianId = null;
        message = "Bagian berhasil diupdate";
        isError = false;
    }

    private async Task ToggleBagianStatus(MasterBagian item)
    {
        item.IsActive = !item.IsActive;
        await DbContext.SaveChangesAsync();
        message = $"Status bagian berhasil diubah";
        isError = false;
    }

    // Units
    private async Task AddUnit()
    {
        if (string.IsNullOrWhiteSpace(newUnitName)) return;
        DbContext.MasterUnits.Add(new MasterUnit { NamaUnit = newUnitName });
        await DbContext.SaveChangesAsync();
        newUnitName = "";
        message = "Unit berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditUnit(MasterUnit item)
    {
        editingUnitId = item.UnitID;
        editUnitName = item.NamaUnit;
    }

    private async Task SaveUnit(MasterUnit item)
    {
        item.NamaUnit = editUnitName;
        await DbContext.SaveChangesAsync();
        editingUnitId = null;
        message = "Unit berhasil diupdate";
        isError = false;
    }

    private async Task ToggleUnitStatus(MasterUnit item)
    {
        item.IsActive = !item.IsActive;
        await DbContext.SaveChangesAsync();
        message = $"Status unit berhasil diubah";
        isError = false;
    }
}
