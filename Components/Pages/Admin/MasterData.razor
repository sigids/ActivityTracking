            <input type="text" @bind="newBagianName" placeholder="Nama Bagian Baru" class="form-control" />
            <button class="btn btn-primary" @onclick="AddBagian">Tambah</button>
        </div>
        <table class="user-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama Bagian</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (bagians != null)
                {
                    @foreach (var item in bagians)
                    {
                        <tr>
                            <td>@item.BagianID</td>
                            <td>
                                @if (editingBagianId == item.BagianID)
                                {
