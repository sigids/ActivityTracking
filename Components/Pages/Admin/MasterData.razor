@code {
    private string activeTab = "activities";
    private string? message;
    private bool isError;

    private List<MasterActivity>? activities;
    private List<MasterFrequency>? frequencies;
    private List<MasterWorkMethod>? methods;
    private List<MasterApplication>? applications;
    private List<MasterJabatan>? jabatans;
    private List<MasterBagian>? bagians;
    private List<MasterUnit>? units;
    private List<MasterComputer>? computers;
    private List<MasterPengguna>? penggunas;
    private List<MasterJenisDok>? jenisdoks;
    private List<MasterAsalDok>? asaldoks;

    private string newActivityName = "";
    private string newFrequencyName = "";
    private string newMethodName = "";
    private string newAppName = "";
    private string newJabatanName = "";
    private string newBagianName = "";
    private string newUnitName = "";
    private string newComputerName = "";
    private string newPenggunaName = "";
    private string newJenisDokName = "";
    private string newAsalDokName = "";

    private int? editingActivityId;
    private int? editingFrequencyId;
    private int? editingMethodId;
    private int? editingAppId;
    private int? editingJabatanId;
    private int? editingBagianId;
    private int? editingUnitId;
    private int? editingComputerId;
    private int? editingPenggunaId;
    private int? editingJenisDokId;
    private int? editingAsalDokId;

    private string editActivityName = "";
    private string editFrequencyName = "";
    private string editMethodName = "";
    private string editAppName = "";
    private string editJabatanName = "";
    private string editBagianName = "";
    private string editUnitName = "";
    private string editComputerName = "";
    private string editPenggunaName = "";
    private string editJenisDokName = "";
    private string editAsalDokName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        activities = await DbContext.MasterActivities.OrderBy(x => x.AktivitasID).ToListAsync();
        frequencies = await DbContext.MasterFrequencies.OrderBy(x => x.FrequencyID).ToListAsync();
        methods = await DbContext.MasterWorkMethods.OrderBy(x => x.MethodID).ToListAsync();
        applications = await DbContext.MasterApplications.OrderBy(x => x.ApplicationID).ToListAsync();
        jabatans = await DbContext.MasterJabatans.OrderBy(x => x.JabatanID).ToListAsync();
        bagians = await DbContext.MasterBagians.OrderBy(x => x.BagianID).ToListAsync();
        units = await DbContext.MasterUnits.OrderBy(x => x.UnitID).ToListAsync();
        computers = await DbContext.MasterComputers.OrderBy(x => x.ComputerID).ToListAsync();
        penggunas = await DbContext.MasterPenggunas.OrderBy(x => x.PenggunaID).ToListAsync();
        jenisdoks = await DbContext.MasterJenisDoks.OrderBy(x => x.JenisDokID).ToListAsync();
        asaldoks = await DbContext.MasterAsalDoks.OrderBy(x => x.AsalDokID).ToListAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        CancelEdit();
    }

    private void CancelEdit()
    {
        editingActivityId = null;
        editingFrequencyId = null;
        editingMethodId = null;
        editingAppId = null;
        editingJabatanId = null;
        editingBagianId = null;
        editingUnitId = null;
        editingComputerId = null;
        editingPenggunaId = null;
        editingJenisDokId = null;
        editingAsalDokId = null;
    }

    // Activities
    private async Task AddActivity()
    {
        if (string.IsNullOrWhiteSpace(newActivityName)) return;
        DbContext.MasterActivities.Add(new MasterActivity { NamaAktivitas = newActivityName });
        await DbContext.SaveChangesAsync();
        newActivityName = "";
        message = "Aktivitas berhasil ditambahkan";
        isError = false;
        await LoadAllData();
    }

    private void EditActivity(MasterActivity item)
    {
        editingActivityId = item.AktivitasID;
        editActivityName = item.NamaAktivitas;
    }

    private async Task SaveActivity(MasterActivity item)
    {
        item.NamaAktivitas = editActivityName;
        await DbContext.SaveChangesAsync();
        editingActivityId = null;
        message = "Aktivitas berhasil diupdate";
        isError = false;
    }

