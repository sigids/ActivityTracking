                                    <input type="text" @bind="editMethodName" class="form-control" />
                                }
                                else
                                {
                                    @item.NamaMetode
                                }
                            </td>
                            <td>@(item.IsActive ? "Aktif" : "Nonaktif")</td>
                            <td>
                                @if (editingMethodId == item.MethodID)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveMethod(item)">Simpan</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Batal</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="() => EditMethod(item)">Edit</button>
                                    <button class="btn btn-warning btn-sm" @onclick="() => ToggleMethodStatus(item)">@(item.IsActive ? "Nonaktifkan" : "Aktifkan")</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else if (activeTab == "applications")
    {
        <div class="form-inline mb-3">
            <input type="text" @bind="newAppName" placeholder="Nama Aplikasi Baru" class="form-control" />
            <button class="btn btn-primary" @onclick="AddApplication">Tambah</button>
        </div>
        <table class="user-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama Aplikasi</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (applications != null)
                {
                    @foreach (var item in applications)
                    {
                        <tr>
                            <td>@item.ApplicationID</td>
                            <td>
                                @if (editingAppId == item.ApplicationID)
                                {
                                    <input type="text" @bind="editAppName" class="form-control" />
                                }
                                else
                                {
                                    @item.NamaAplikasi
                                }
                            </td>
                            <td>@(item.IsActive ? "Aktif" : "Nonaktif")</td>
                            <td>
                                @if (editingAppId == item.ApplicationID)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveApplication(item)">Simpan</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Batal</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="() => EditApplication(item)">Edit</button>
                                    <button class="btn btn-warning btn-sm" @onclick="() => ToggleAppStatus(item)">@(item.IsActive ? "Nonaktifkan" : "Aktifkan")</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else if (activeTab == "jabatans")
    {
        <div class="form-inline mb-3">
            <input type="text" @bind="newJabatanName" placeholder="Nama Jabatan Baru" class="form-control" />
            <button class="btn btn-primary" @onclick="AddJabatan">Tambah</button>
        </div>
        <table class="user-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama Jabatan</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (jabatans != null)
                {
                    @foreach (var item in jabatans)
                    {
                        <tr>
                            <td>@item.JabatanID</td>
                            <td>
                                @if (editingJabatanId == item.JabatanID)
                                {
                                    <input type="text" @bind="editJabatanName" class="form-control" />
                                }
                                else
                                {
                                    @item.NamaJabatan
                                }
                            </td>
                            <td>@(item.IsActive ? "Aktif" : "Nonaktif")</td>
                            <td>
                                @if (editingJabatanId == item.JabatanID)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveJabatan(item)">Simpan</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Batal</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="() => EditJabatan(item)">Edit</button>
                                    <button class="btn btn-warning btn-sm" @onclick="() => ToggleJabatanStatus(item)">@(item.IsActive ? "Nonaktifkan" : "Aktifkan")</button>
                                }
                            </td>
                        </tr>
                    }
