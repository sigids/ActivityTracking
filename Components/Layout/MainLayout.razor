@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="app-container sidebar-open">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h4 class="sidebar-title">Activity Tracking</h4>
            <button class="sidebar-toggle" onclick="toggleSidebar()">
                <span class="toggle-icon">&lt;</span>
            </button>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="/" class="menu-link">
                    <span class="menu-icon">&#127968;</span>
                    <span class="menu-text">Home</span>
                </a>
            </li>
            <AuthorizeView>
                <Authorized>
                    <li class="menu-item">
                        <a href="/dashboard" class="menu-link">
                            <span class="menu-icon">&#128202;</span>
                            <span class="menu-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="/activity-list" class="menu-link">
                            <span class="menu-icon">&#128221;</span>
                            <span class="menu-text">Input Aktivitas</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="/users" class="menu-link">
                            <span class="menu-icon">&#128100;</span>
                            <span class="menu-text">Pengguna</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="/jam-kerja" class="menu-link">
                            <span class="menu-icon">&#128336;</span>
                            <span class="menu-text">Jam Kerja</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="/admin/master-data" class="menu-link">
                            <span class="menu-icon">&#128451;</span>
                            <span class="menu-text">Master Data</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="/Account/Manage" class="menu-link">
                            <span class="menu-icon">&#9881;</span>
                            <span class="menu-text">Akun Saya</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <form action="/Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="/" />
                            <button type="submit" class="menu-link logout-btn">
                                <span class="menu-icon">&#128682;</span>
                                <span class="menu-text">Logout</span>
                            </button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="menu-item">
                        <a href="/Account/Login" class="menu-link">
                            <span class="menu-icon">&#128274;</span>
                            <span class="menu-text">Login</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="/Account/Register" class="menu-link">
                            <span class="menu-icon">&#128221;</span>
                            <span class="menu-text">Register</span>
                        </a>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </nav>

    <main class="main-content">
        <header class="top-header">
            <button class="mobile-toggle" onclick="toggleSidebar()">
                <span>&#9776;</span>
            </button>
            <div class="header-user">
                <AuthorizeView>
                    <Authorized>
                        <span>Welcome, @context.User.Identity?.Name</span>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/Account/Login">Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>
        <div class="content-area">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>
